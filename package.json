{
  "name": "bytecast-tests",
  "version": "1.0.0",
  "description": "Playwright tests for ByteCast workspace user journeys",
  "scripts": {
    "test": "playwright test",
    "test:all-browsers": "set BYTECAST_ALL_BROWSERS=1&& playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "bootstrap:catalog": "node scripts/bootstrap-catalog.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "upgrade:trainings": "node scripts/apply-training-upgrade.mjs",
    "fix:mojibake": "node scripts/fix-mojibake.mjs",
    "build:agent-day1-vo": "python scripts/first_door_voiceover_build.py",
    "build:agent-day2-vo": "python scripts/source_of_truth_voiceover_build.py",
    "build:agent-day3-vo": "python scripts/signal_to_action_voiceover_build.py",
    "build:agent-day4-vo": "python scripts/handoff_is_the_work_voiceover_build.py",
    "probe:tts": "node scripts/probe-nxcore-tts.mjs",
    "forge:agent-day1": "node scripts/narration-forge-agent-day1.mjs",
    "forge:agent-day2": "node scripts/narration-forge-agent-day2.mjs",
    "forge:agent-day3": "node scripts/narration-forge-agent-day3.mjs",
    "forge:agent-day4": "node scripts/narration-forge-agent-day4.mjs",
    "build:agent-days-5-10": "node scripts/build-agent-days-5-10.mjs",
    "upgrade:agent-days-interactive": "node scripts/upgrade-agent-days-interactive.mjs",
    "build:agent-days-5-10-vo": "python scripts/agent_day_voiceover_build.py --all",
    "forge:agent-day5": "node scripts/narration-forge-agent-day.mjs 5",
    "forge:agent-day6": "node scripts/narration-forge-agent-day.mjs 6",
    "forge:agent-day7": "node scripts/narration-forge-agent-day.mjs 7",
    "forge:agent-day8": "node scripts/narration-forge-agent-day.mjs 8",
    "forge:agent-day9": "node scripts/narration-forge-agent-day.mjs 9",
    "forge:agent-day10": "node scripts/narration-forge-agent-day.mjs 10",
    "forge:agent-days-5-10": "node scripts/narration-forge-agent-day.mjs 5 6 7 8 9 10",
    "narrate:agent-days-5-10": "python scripts/agent_day_voiceover_build.py --all && node scripts/narration-forge-agent-day.mjs 5 6 7 8 9 10",
    "check:episodes": "node -e \"process.chdir(process.env.INIT_CWD||process.cwd()); import('node:url').then(({pathToFileURL})=>import(pathToFileURL(require('node:path').join(process.cwd(),'scripts/check-episodes.mjs'))))\"",
    "test:golden-path": "playwright test tests/golden-path.spec.js",
    "test:seeding": "playwright test tests/seeding-track.spec.js",
    "test:division": "playwright test tests/division-track.spec.js",
    "test:navigation": "playwright test tests/navigation.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
